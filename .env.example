# Copy only when .env does not already exist. Never commit real credentials.
# Docker Compose: set these to the output of id -u and id -g for your non-root user.
RCON_UID=REPLACE_WITH_ID_U
RCON_GID=REPLACE_WITH_ID_G
# Absolute HOST path outside the checkout. Do not use ~ here.
RCON_KEY_DIR=/home/REPLACE_WITH_USER/.config/seedhub-rcon

SEEDHUB_RCON_PUBLIC_URL=https://rcon.seedhub.gg
SEEDHUB_RCON_BIND_PORT=8080
# Compose fixes the database path inside the container; ./data persists on the VPS.
SEEDHUB_RCON_DB_PATH=/data/seedhub-rcon.sqlite3
# CONTAINER path: the host RCON_KEY_DIR is mounted read-only here.
SEEDHUB_RCON_KEY_FILE=/run/seedhub-rcon/encryption.key
SEEDHUB_RCON_DISCORD_CLIENT_ID=REPLACE_WITH_DISCORD_APPLICATION_ID
SEEDHUB_RCON_DISCORD_CLIENT_SECRET=REPLACE_WITH_DISCORD_CLIENT_SECRET
# Callback is derived from PUBLIC_URL: /auth/discord/callback
# Restrict a test deployment to your test Discord accounts (comma separated).
# Explicitly use * only when you intend to open sign-in to everyone.
SEEDHUB_RCON_ALLOWED_DISCORD_IDS=REPLACE_WITH_YOUR_DISCORD_USER_ID
# Optional HTTPS support link; set a private support channel before public launch.
SEEDHUB_RCON_SUPPORT_URL=
# API keys are generated in the website and stored only as digests.
# cloudflared uses its own protected configuration; do not put its token here.
